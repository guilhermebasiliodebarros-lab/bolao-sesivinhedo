rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMaster() {
      return signedIn() && currentUser().role == "master";
    }

    function isParticipant() {
      return signedIn()
        && currentUser().role == "user"
        && currentUser().participaRanking == true;
    }

    function gameAcceptsPredictions(gameId) {
      let game = get(/databases/$(database)/documents/games/$(gameId)).data;

      return game.status == "aberto"
        && (!game.keys().hasAny(["deletionPending"]) || game.deletionPending == null)
        && (!game.keys().hasAny(["matchCondition"]) || game.matchCondition == "normal")
        && (!game.keys().hasAny(["liveStatus"]) || game.liveStatus != "live")
        && (!game.keys().hasAny(["startedAt"]) || game.startedAt == null)
        && game.keys().hasAny(["limitePalpites"])
        && game.limitePalpites is timestamp
        && request.time < game.limitePalpites;
    }

    function gameCanReceiveRecords(gameId) {
      let path = /databases/$(database)/documents/games/$(gameId);
      return exists(path)
        && (!get(path).data.keys().hasAny(["deletionPending"]) || get(path).data.deletionPending == null);
    }

    function validNonNegativeScores() {
      let game = get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data;
      let mode = game.keys().hasAny(["scoringMode"]) ? game.scoringMode : (game.esporteNome == "Xadrez" ? "chess" : "points");
      let a = request.resource.data.palpiteA;
      let b = request.resource.data.palpiteB;
      let target = game.keys().hasAny(["volleyballBestOf"]) && game.volleyballBestOf == 5 ? 3 : 2;
      return mode == "chess"
        ? ((a == 1 && b == 0) || (a == 0 && b == 1) || (a == 0.5 && b == 0.5))
        : (a is int && b is int && a >= 0 && b >= 0 && a <= 10000 && b <= 10000
          && (mode != "sets" || ((a == target && b < target) || (b == target && a < target))));
    }

    function userCannotChangeScoreOrRole() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nome", "avatarUrl", "photoURL", "fotoUrl", "updatedAt"]);
    }

    function predictionCreatedByOwner() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "userId",
          "gameId",
          "nomeUsuario",
          "palpiteA",
          "palpiteB",
          "pontos",
          "acertoExato",
          "acertoResultado",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.pontos == 0
        && request.resource.data.acertoExato == false
        && request.resource.data.acertoResultado == false
        && validNonNegativeScores()
        && gameAcceptsPredictions(request.resource.data.gameId);
    }

    function predictionEditedByOwner() {
      return resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.pontos == 0
        && request.resource.data.acertoExato == false
        && request.resource.data.acertoResultado == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "nomeUsuario",
          "palpiteA",
          "palpiteB",
          "pontos",
          "acertoExato",
          "acertoResultado",
          "updatedAt"
        ])
        && validNonNegativeScores()
        && gameAcceptsPredictions(resource.data.gameId);
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == "user"
        && request.resource.data.participaRanking == true
        && request.resource.data.pontos == 0
        && request.resource.data.acertosExatos == 0
        && request.resource.data.acertosResultado == 0;

      allow update: if isMaster()
        || (signedIn() && request.auth.uid == uid && userCannotChangeScoreOrRole());

      allow delete: if isMaster();
    }

    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if isMaster();

      match /documents/{documentId} {
        allow read, delete: if isMaster();
        allow create, update: if isMaster() && gameCanReceiveRecords(gameId);
      }
      match /events/{eventId} {
        allow read, delete: if isMaster();
        allow create, update: if isMaster() && gameCanReceiveRecords(gameId);
      }
    }

    match /sports/{sportId} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }

    match /announcements/{announcementId} {
      allow read: if isMaster() || resource.data.active == true;
      allow create, update, delete: if isMaster();
    }

    match /broadcastSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }

    match /operations/{operationId} {
      allow read, write: if isMaster();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if isMaster();

      match /players/{playerId} {
        allow read, write: if isMaster();
      }
    }

    match /predictions/{predictionId} {
      allow read: if signedIn() && (isMaster() || resource.data.userId == request.auth.uid);
      allow get: if signedIn() && !exists(/databases/$(database)/documents/predictions/$(predictionId));
      allow create: if isParticipant() && predictionCreatedByOwner();
      allow update: if isMaster() || (isParticipant() && predictionEditedByOwner());
      allow delete: if isMaster();
    }
  }
}
