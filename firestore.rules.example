rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMaster() {
      return signedIn() && currentUser().role == "master";
    }

    function isParticipant() {
      return signedIn()
        && currentUser().role == "user"
        && currentUser().get("approvalStatus", "pending") == "approved"
        && currentUser().participaRanking == true;
    }

    function isRegistrationReviewer() {
      return signedIn() && request.auth.token.email.lower() == "guilhermebasiliodebarros@gmail.com";
    }

    function hasEventAccess() {
      return signedIn() && (isMaster() || currentUser().role == "viewer" || isParticipant());
    }

    function approvalFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "approvalStatus", "participaRanking", "approvalReviewedBy", "approvalReviewedAt"
      ]);
    }

    function scoreFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["pontos", "acertosExatos", "acertosResultado", "acertosPontuador", "rankingPorEsporte", "scoreUpdatedAt"]);
    }

    function predictionScoreUnchanged() {
      return request.resource.data.get("pontos", 0) == resource.data.get("pontos", 0)
        && request.resource.data.get("acertoExato", false) == resource.data.get("acertoExato", false)
        && request.resource.data.get("acertoResultado", false) == resource.data.get("acertoResultado", false)
        && request.resource.data.get("acertoPontuador", false) == resource.data.get("acertoPontuador", false)
        && request.resource.data.get("scoreUpdatedAt", null) == resource.data.get("scoreUpdatedAt", null);
    }

    function operatorPredictionScoreUpdate() {
      let value = request.resource.data;
      return isMaster()
        && value.diff(resource.data).affectedKeys().hasOnly(["pontos", "acertoExato", "acertoResultado", "acertoPontuador", "scoreUpdatedAt"])
        && value.pontos is int && value.pontos >= 0 && value.pontos <= 2
        && value.acertoExato is bool && value.acertoResultado is bool && value.acertoPontuador is bool
        && !(value.acertoExato && value.acertoPontuador)
        && value.pontos == (value.acertoResultado ? 1 : 0) + (value.acertoExato ? 1 : 0) + (value.acertoPontuador ? 1 : 0)
        && value.scoreUpdatedAt == request.time;
    }

    function operatorProfileScoreUpdate() {
      let value = request.resource.data;
      return isMaster()
        && value.diff(resource.data).affectedKeys().hasOnly(["pontos", "acertosExatos", "acertosResultado", "acertosPontuador", "rankingPorEsporte", "scoreUpdatedAt"])
        && value.pontos is int && value.pontos >= 0
        && value.acertosExatos is int && value.acertosExatos >= 0
        && value.acertosResultado is int && value.acertosResultado >= 0
        && value.acertosPontuador is int && value.acertosPontuador >= 0
        && value.rankingPorEsporte is map && value.scoreUpdatedAt == request.time;
    }

    function validPredictionStats() {
      let value = request.resource.data;
      return value.keys().hasOnly(["teamA", "teamB", "draw", "total", "updatedAt"])
        && value.teamA is int && value.teamA >= 0 && value.teamB is int && value.teamB >= 0
        && value.draw is int && value.draw >= 0 && value.total == value.teamA + value.teamB + value.draw
        && value.updatedAt == request.time;
    }

    function publicPredictionStatsOpen(gameId) {
      let game = get(/databases/$(database)/documents/games/$(gameId)).data;
      return game.get("matchCondition", "normal") == "normal"
        && (game.get("status", "") in ["finalizado", "finished"] || game.get("startedAt", null) != null
          || (game.get("limitePalpites", null) is timestamp && request.time >= game.limitePalpites
            && (!(game.get("dataHora", null) is timestamp) || request.time >= game.dataHora - duration.value(5, "m"))));
    }

    function validRegistrationReview() {
      return isRegistrationReviewer()
        && resource.data.role == "user"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "approvalStatus", "participaRanking", "approvalReviewedBy", "approvalReviewedAt", "updatedAt"
        ])
        && request.resource.data.approvalStatus in ["approved", "rejected"]
        && request.resource.data.participaRanking == (request.resource.data.approvalStatus == "approved")
        && request.resource.data.approvalReviewedBy == request.auth.uid
        && request.resource.data.approvalReviewedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function gameAcceptsPredictions(gameId) {
      let game = get(/databases/$(database)/documents/games/$(gameId)).data;

      return game.status == "aberto"
        && (!game.keys().hasAny(["deletionPending"]) || game.deletionPending == null)
        && (!game.keys().hasAny(["matchCondition"]) || game.matchCondition == "normal")
        && (!game.keys().hasAny(["liveStatus"]) || game.liveStatus != "live")
        && (!game.keys().hasAny(["startedAt"]) || game.startedAt == null)
        && game.keys().hasAny(["limitePalpites"])
        && game.limitePalpites is timestamp
        && request.time < game.limitePalpites;
    }

    function gameCanReceiveRecords(gameId) {
      let path = /databases/$(database)/documents/games/$(gameId);
      return exists(path)
        && (!get(path).data.keys().hasAny(["deletionPending"]) || get(path).data.deletionPending == null);
    }

    function validNonNegativeScores() {
      let game = get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data;
      let name = game.get("esporteNome", "").lower();
      let mode = game.get("scoringMode", name == "xadrez" ? "chess" : (name in ["vôlei", "volei", "voleibol", "volleyball"] ? "sets" : "points"));
      let a = request.resource.data.palpiteA;
      let b = request.resource.data.palpiteB;
      let target = 2;
      return mode == "chess"
        ? ((a == 1 && b == 0) || (a == 0 && b == 1) || (a == 0.5 && b == 0.5))
        : (a is int && b is int && a >= 0 && b >= 0 && a <= 10000 && b <= 10000
          && (mode != "sets" || ((a == target && b < target) || (b == target && a < target))));
    }

    function userCannotChangeScoreOrRole() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nome", "avatarUrl", "photoURL", "fotoUrl", "updatedAt"]);
    }

    function selectedTopScorerIsValid() {
      let pick = request.resource.data;
      let game = get(/databases/$(database)/documents/games/$(pick.gameId)).data;
      let team = get(/databases/$(database)/documents/teams/$(pick.topScorerTeamId)).data;
      let player = get(/databases/$(database)/documents/teams/$(pick.topScorerTeamId)/players/$(pick.topScorerPlayerId)).data;
      return game.get("esporteNome", "").lower().matches(".*(basquet|basket|v[oô]lei|voleibol|volley).*")
        && pick.topScorerTeamId is string && pick.topScorerTeamId.size() > 0 && pick.topScorerTeamId.size() <= 256
        && pick.topScorerPlayerId is string && pick.topScorerPlayerId.size() > 0 && pick.topScorerPlayerId.size() <= 256
        && pick.topScorerSide in ["A", "B"]
        && pick.topScorerName == player.nome
        && team.sportId == game.sportId
        && (game.get("turno", "") == "" || team.get("turno", "") == game.turno)
        && ((pick.topScorerSide == "A" && game.get("seedLabelA", "") == ""
            && (game.get("teamIdA", "") != "" ? pick.topScorerTeamId == game.teamIdA : team.nome == game.timeA))
          || (pick.topScorerSide == "B" && game.get("seedLabelB", "") == ""
            && (game.get("teamIdB", "") != "" ? pick.topScorerTeamId == game.teamIdB : team.nome == game.timeB)));
    }

    function validTopScorer() {
      let pick = request.resource.data;
      return pick.get("topScorerPlayerId", "") == ""
        ? pick.get("topScorerTeamId", "") == "" && pick.get("topScorerSide", "") == "" && pick.get("topScorerName", "") == ""
        : selectedTopScorerIsValid();
    }

    function predictionCreatedByOwner() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "userId",
          "gameId",
          "nomeUsuario",
          "palpiteA",
          "palpiteB",
          "pontos",
          "acertoExato",
          "acertoResultado",
          "acertoPontuador",
          "topScorerTeamId", "topScorerPlayerId", "topScorerSide", "topScorerName",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.pontos == 0
        && request.resource.data.acertoExato == false
        && request.resource.data.acertoResultado == false
        && request.resource.data.get("acertoPontuador", false) == false
        && validTopScorer()
        && validNonNegativeScores()
        && gameAcceptsPredictions(request.resource.data.gameId);
    }

    function predictionEditedByOwner() {
      return resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.pontos == 0
        && request.resource.data.acertoExato == false
        && request.resource.data.acertoResultado == false
        && request.resource.data.get("acertoPontuador", false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "nomeUsuario",
          "palpiteA",
          "palpiteB",
          "pontos",
          "acertoExato",
          "acertoResultado",
          "acertoPontuador",
          "topScorerTeamId", "topScorerPlayerId", "topScorerSide", "topScorerName",
          "updatedAt"
        ])
        && validNonNegativeScores()
        && validTopScorer()
        && gameAcceptsPredictions(resource.data.gameId);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMaster() || isRegistrationReviewer()
        || (isParticipant() && resource.data.role == "user" && resource.data.approvalStatus == "approved" && resource.data.participaRanking == true));

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "user"
        && request.resource.data.keys().hasOnly([
          "uid", "nome", "email", "avatarUrl", "role", "approvalStatus", "participaRanking",
          "pontos", "acertosExatos", "acertosResultado", "createdAt", "updatedAt"
        ])
        && request.resource.data.approvalStatus == "pending"
        && request.resource.data.participaRanking == false
        && request.resource.data.pontos == 0
        && request.resource.data.acertosExatos == 0
        && request.resource.data.acertosResultado == 0;

      allow update: if (isMaster() && approvalFieldsUnchanged() && scoreFieldsUnchanged())
        || operatorProfileScoreUpdate()
        || validRegistrationReview()
        || (signedIn() && currentUser().role == "user" && request.auth.uid == uid && userCannotChangeScoreOrRole());

      allow delete: if isMaster();

      match /preferences/scheduleNotices {
        allow read: if signedIn() && request.auth.uid == uid && isParticipant();
        allow create, update: if signedIn() && request.auth.uid == uid && isParticipant()
          && request.resource.data.keys().hasOnly(["readIds", "updatedAt"])
          && request.resource.data.readIds is list && request.resource.data.readIds.size() <= 100
          && request.resource.data.updatedAt == request.time;
      }
    }

    match /games/{gameId} {
      allow read: if hasEventAccess();
      allow create, update, delete: if isMaster();

      match /public/predictionStats {
        allow get: if isMaster() || (hasEventAccess() && publicPredictionStatsOpen(gameId));
        allow create, update: if isMaster() && exists(/databases/$(database)/documents/games/$(gameId)) && validPredictionStats();
        allow delete: if isMaster();
      }

      match /documents/{documentId} {
        allow read, delete: if isMaster();
        allow create, update: if isMaster() && gameCanReceiveRecords(gameId);
      }
      match /events/{eventId} {
        allow read, delete: if isMaster();
        allow create, update: if isMaster() && gameCanReceiveRecords(gameId);
      }
    }

    match /sports/{sportId} {
      allow read: if hasEventAccess();
      allow create, update, delete: if isMaster();
    }

    match /announcements/{announcementId} {
      allow read: if hasEventAccess() && (isMaster() || resource.data.active == true);
      allow create, update, delete: if isMaster();
    }

    match /scheduleNotices/{noticeId} {
      allow read: if hasEventAccess();
      allow write: if isMaster();
    }

    match /broadcastSettings/{settingId} {
      allow read: if hasEventAccess();
      allow create, update, delete: if isMaster();
    }

    match /operations/{operationId} {
      allow read, write: if isMaster();
    }

    match /system/{stateId} {
      allow get: if hasEventAccess() && stateId == "scoring";
      allow create, update: if isMaster() && stateId == "scoring"
        && request.resource.data.keys().hasOnly(["token", "revision", "status", "mode", "startedAt", "error", "failedAt", "completedRevision", "completedAt", "predictions", "participants", "changed", "sourceKey", "rulesVersion"])
        && request.resource.data.token is string && request.resource.data.revision is int
        && request.resource.data.status in ["processing", "complete", "error"];
    }

    match /teams/{teamId} {
      allow read: if hasEventAccess();
      allow create, update, delete: if isMaster();

      match /players/{playerId} {
        allow read, write: if isMaster();
      }
      match /public/predictionPlayers {
        allow get: if isMaster() || isParticipant();
        allow create, update: if isMaster()
          && request.resource.data.keys().hasOnly(["teamId", "teamName", "sportId", "turno", "players", "sourceUpdatedAt", "updatedAt"])
          && request.resource.data.teamId == teamId
          && request.resource.data.teamName == getAfter(/databases/$(database)/documents/teams/$(teamId)).data.nome
          && request.resource.data.sportId == getAfter(/databases/$(database)/documents/teams/$(teamId)).data.sportId
          && request.resource.data.players is list && request.resource.data.players.size() <= 1000
          && request.resource.data.sourceUpdatedAt == getAfter(/databases/$(database)/documents/teams/$(teamId)).data.get("updatedAt", null)
          && request.resource.data.updatedAt == request.time;
        allow delete: if isMaster();
      }
    }

    match /predictions/{predictionId} {
      allow read: if isMaster() || (isParticipant() && resource.data.userId == request.auth.uid);
      allow get: if (isMaster() || isParticipant()) && !exists(/databases/$(database)/documents/predictions/$(predictionId));
      allow create: if (isMaster() && request.resource.data.get("pontos", 0) == 0 && request.resource.data.get("acertoExato", false) == false && request.resource.data.get("acertoResultado", false) == false && request.resource.data.get("acertoPontuador", false) == false && request.resource.data.get("scoreUpdatedAt", null) == null) || (isParticipant() && predictionCreatedByOwner());
      allow update: if (isMaster() && predictionScoreUnchanged()) || operatorPredictionScoreUpdate() || (isParticipant() && predictionEditedByOwner());
      allow delete: if isMaster();
    }
  }
}
